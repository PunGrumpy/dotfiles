{{- $wsl := and (eq .chezmoi.os "linux") (contains "microsoft" (lower .chezmoi.kernel.osrelease)) -}}
{{- $opSign := printf "%s/AppData/Local/1Password/app/8/op-ssh-sign.exe" .chezmoi.homeDir -}}
[gpg]
	format = ssh
[commit]
	gpgsign = true
[init]
  defaultBranch = main
[core]
	excludesfile = ~/.gitignore
	editor = nvim
  pager = delta
	ignorecase = false
	longpaths = true
	autocrlf = false
{{- if $wsl }}
	sshCommand = ssh.exe
{{- else if eq .chezmoi.os "windows" }}
	sshCommand = C:/Windows/System32/OpenSSH/ssh.exe
{{- end }}
[push]
  default = simple
[color]
  status = auto
  diff = auto
  branch = auto
  interactive = auto
  grep = auto
  ui = auto
[diff]
  tool = nvimdiff
[difftool "nvimdiff"]
  cmd = nvim -d \"$LOCAL\" \"$REMOTE\"
  path =
[mergetool "nvimdiff"]
	cmd = nvim -d \"$LOCAL\" \"$REMOTE\" -ancestor \"$BASE\" -merge \"$MERGED\"
	trustExitCode = true
[filter "lfs"]
  clean = git-lfs clean -- %f
  smudge = git-lfs smudge -- %f
  required = true
  process = git-lfs filter-process
[pull]
  rebase = false
[safe]
  directory = *
[gpg "ssh"]
  allowedSignersFile = ~/.config/git/allowed_signers
{{- if eq .chezmoi.os "darwin" }}
	program = /Applications/1Password.app/Contents/MacOS/op-ssh-sign
{{- else if eq .chezmoi.os "windows" }}
	program = {{ if stat $opSign }}{{ $opSign }}{{ else }}op-ssh-sign.exe{{ end }}
{{- else if $wsl }}
	program = op-ssh-sign-wsl.exe
{{- end }}
[credential]
  helper = cache
[credential "https://github.com"]
	helper = 
	helper = !{{ if eq .chezmoi.os "darwin" }}/opt/homebrew/bin/{{ end }}gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !{{ if eq .chezmoi.os "darwin" }}/opt/homebrew/bin/{{ end }}gh auth git-credential
[include]
  path = ~/.config/git/aliases.gitconfig
[include]
  path = ~/.config/git/ghq.gitconfig
[include]
  path = ~/.config/git/delta.gitconfig
[include]
  path = ~/.config/git/github.gitconfig
[includeIf "hasconfig:remote.*.url:**/**gitlab.nipa.cloud**/**"]
  path = ~/.config/git/nipa-gitlab.gitconfig
[includeIf "hasconfig:remote.*.url:**/**git.cafe**/**"]
  path = ~/.config/git/gitcafe.gitconfig
[includeIf "hasconfig:remote.*.url:**/**opendev.org**/**"]
  path = ~/.config/git/opendev.gitconfig
[includeIf "hasconfig:remote.*.url:**/**opensdn.io**/**"]
  path = ~/.config/git/opensdn.gitconfig
