{{- if ne .chezmoi.os "windows" -}}
#!/bin/bash
# fish_plugins hash: {{ include "dot_config/fish/fish_plugins" | sha256sum }}
set -euo pipefail

{{ template "brew-env.sh" }}

fish -c '
  type -q fisher
  or curl -fsSL https://raw.githubusercontent.com/jorgebucaran/fisher/main/functions/fisher.fish | source
  fisher update
' </dev/null
{{- end }}
