{{- if eq .chezmoi.os "windows" -}}
$ErrorActionPreference = 'Stop'

$documents = [Environment]::GetFolderPath('MyDocuments')
foreach ($folder in 'PowerShell', 'WindowsPowerShell') {
  $profilePath = Join-Path $documents "$folder\Microsoft.PowerShell_profile.ps1"
  if (Test-Path -LiteralPath $profilePath) {
    Remove-Item -LiteralPath $profilePath -Force
  }
  New-Item -ItemType File -Force -Path $profilePath -Value '. "$HOME\.config\powershell\user_profile.ps1"' | Out-Null
}
{{- end }}
