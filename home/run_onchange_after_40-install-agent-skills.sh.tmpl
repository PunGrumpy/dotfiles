{{- if ne .chezmoi.os "windows" -}}
#!/bin/bash
set -uo pipefail

{{ template "brew-env.sh" }}

export PATH="$HOME/.local/share/vite-plus/bin:$PATH"

if ! command -v bunx >/dev/null 2>&1; then
  echo "bunx not found, skipping agent skills" >&2
  exit 0
fi

export GIT_SSH_COMMAND="$(git config --global core.sshCommand || echo ssh) -o BatchMode=yes"

failed=0
skill() { bunx skills add "$@" --global --yes --agent cursor </dev/null || failed=$((failed + 1)); }
skill mattpocock/skills --skill grilling
skill vercel-labs/agent-skills --skill writing-guidelines
skill shadcn/improve --skill improve
skill vercel/turborepo --skill turborepo
skill millionco/react-doctor --skill react-doctor improve-react improve-threejs performance deslop
skill t3dotgg/tstack
skill rauchg/skills
skill emilkowalski/skills --skill emil-design-eng review-animations
skill benjitaylor/skills
skill gustavo-fior/craft
skill git@github.com:PunGrumpy/agents.git --skill cli-builder dx-design rust-best-practices style-transfer system-design testing-patterns

if [ "$failed" -gt 0 ]; then
  echo "$failed skill sources failed. Install them again with 'bunx skills add'." >&2
fi
{{- end }}
