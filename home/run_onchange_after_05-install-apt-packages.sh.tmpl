{{- if and (eq .chezmoi.os "linux") (or (eq .chezmoi.osRelease.id "debian") (eq .chezmoi.osRelease.id "ubuntu")) -}}
#!/bin/bash
# apt-packages.txt hash: {{ include "apt-packages.txt" | sha256sum }}
set -euo pipefail

missing=()
while read -r package; do
  dpkg-query -W -f='${Status}' "$package" 2>/dev/null | grep -q 'ok installed' || missing+=("$package")
done <"{{ joinPath .chezmoi.sourceDir "apt-packages.txt" }}"

if [ "${#missing[@]}" -eq 0 ]; then
  exit 0
fi

sudo apt update
sudo apt install -y "${missing[@]}"
{{- end }}
